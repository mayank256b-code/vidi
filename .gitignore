```gitignore
# Dependencies
node_modules/

# Build outputs
dist/
build/
*.js.map
*.ts.map

# Environment variables
.env
.env.local
*.env.*

# Logs
*.log

# IDE files
.vscode/
.idea/
*.swp
*.swo
*.tmp

# Python cache (if applicable)
__pycache__/
*.pyc
*.pyo
*.pyd

# Coverage reports
coverage/
htmlcov/
.coverage

# OS generated files
.DS_Store
Thumbs.db

# Testing
.mypy_cache/
.pytest_cache/
.nyc_output/
coverage/

# Runtime data
.pnp.cjs
.yarn-integrity
.lock-wscript
.npm
.node_repl_history

# Compiled assets
public/build/
assets/css/*.css.map
assets/js/*.js.map

# Distribution folder
dist/**
```